{
  "name": "referral-repeater",
  "version": "1.0.0",
  "description": "Autonomous, configurable, multi-platform referral link sharing engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "referral-repeater": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli/index.ts",
    "post": "tsx src/cli/index.ts post",
    "daemon": "tsx src/cli/index.ts daemon",
    "setup": "tsx src/cli/index.ts init",
    "validate": "tsx src/cli/index.ts validate",
    "history": "tsx src/cli/index.ts history",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/ --ext .ts",
    "lint:fix": "eslint src/ tests/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "prepare": "husky"
  },
  "keywords": [
    "referral",
    "automation",
    "credit-cards",
    "rewards",
    "multi-platform",
    "scheduler"
  ],
  "author": "Alex Tanton",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "ora": "^5.4.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
