{
  "name": "hermes",
  "version": "1.1.0",
  "description": "Hermes (The Messenger of the Gods) - Autonomous, multi-platform referral link courier",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hermes": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-tanton/Hermes.git"
  },
  "bugs": {
    "url": "https://github.com/alex-tanton/Hermes/issues"
  },
  "homepage": "https://github.com/alex-tanton/Hermes#readme",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run test",
    "start": "tsx src/cli/index.ts",
    "post": "tsx src/cli/index.ts post",
    "daemon": "tsx src/cli/index.ts daemon",
    "setup": "tsx src/cli/index.ts init",
    "validate": "tsx src/cli/index.ts validate",
    "history": "tsx src/cli/index.ts history",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "prepare": "husky"
  },
  "keywords": [
    "referral",
    "automation",
    "credit-cards",
    "rewards",
    "multi-platform",
    "scheduler"
  ],
  "author": "Alex Tanton",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.2",
    "chalk": "^4.1.2",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "node-cron": "^4.6.0",
    "ora": "^5.4.1",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
