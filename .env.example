# Hermes Environment Configuration
NODE_ENV=production

# Discord
# Webhook URL: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=

# Bluesky
# App password: bsky.app -> Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit
# Run 'npx devvit login' for 1-click token setup (stored in ~/.devvit/token).
# Or provide a direct token or script credentials:
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Twitter / X
# Workaround 1: Browser Session Cookies (Zero API keys, 100% free - Recommended)
# On x.com: DevTools (F12) -> Application -> Cookies -> https://x.com:
# Copy the values of 'auth_token' and 'ct0'
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Workaround 2: Account Login (Alternative)
# TWITTER_USERNAME=
# TWITTER_PASSWORD=
# TWITTER_EMAIL=
# TWITTER_2FA_SECRET=
# Optional: Standard API v2 keys (if using Developer Portal Free tier)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# Facebook
# Page access token from Meta for Developers (pages_manage_posts)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
