# ==============================================================================
# Hermes Environment Variables Template
# ==============================================================================
# Copy this file to `.env` to configure your API credentials and secrets.
# DO NOT commit your `.env` file containing real credentials to version control.
# ==============================================================================

# General
NODE_ENV=production

# ------------------------------------------------------------------------------
# Discord Webhook
# ------------------------------------------------------------------------------
# Create an incoming webhook in your target Discord channel:
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_BOT_TOKEN=

# ------------------------------------------------------------------------------
# Bluesky (AT Protocol)
# ------------------------------------------------------------------------------
# Create an App Password in Bluesky: Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# Reddit (Devvit 1-Click Login — Zero Config)
# ------------------------------------------------------------------------------
# RECOMMENDED: Run `npx devvit login` in your terminal to authenticate your account
# with 1 click in your browser. Tokens are stored securely in ~/.devvit/token.
# You do NOT need to fill in these variables if using Devvit!
#
# Optional manual token override:
REDDIT_ACCESS_TOKEN=
#
# Optional legacy script credentials (only needed if NOT using Devvit):
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ------------------------------------------------------------------------------
# Twitter / X API v2 (OAuth 1.0a)
# ------------------------------------------------------------------------------
# Generated from Twitter Developer Portal (with Read & Write permissions enabled)
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ------------------------------------------------------------------------------
# Facebook Graph API (Page Access Token)
# ------------------------------------------------------------------------------
# Generated from Meta for Developers with pages_manage_posts & pages_read_engagement
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
